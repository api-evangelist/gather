        {
          "id": "f16ddd90-8b8c-4a61-b0ff-65a44d875f80",
          "name": "Set map",
          "request": {
            "name": "Set map",
            "description": {
              "content": "Overwrite the map/room data for a given map within a space. The request body carries the new map content (background image, objects, spawns, impassable tiles, and more).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "spaces",
                ":spaceId",
                "maps",
                ":mapId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "useV2Map",
                  "value": "<boolean>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "spaceId",
                  "description": "(Required) The space identifier (URL-encoded; contains a backslash-delimited id)."
                },
