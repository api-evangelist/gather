                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "mapId",
                  "description": "(Required) The map/room identifier within the space."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": {\n    \"backgroundImagePath\": \"<string>\",\n    \"spawns\": [\n      \"<object>\",\n      \"<object>\"\n    ],\n    \"objects\": [\n      \"<object>\",\n      \"<object>\"\n    ],\n    \"collisions\": \"<string>\"\n  }\n}",
